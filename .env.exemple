# This file is used to set environment variables for the birthdaymemo Docker container.

# Set the UID/GID for the container process (default 1000/1000). This is used
# to map the container's user and group IDs to the host's user and group IDs.      
export UUID=1000
export GUID=1000
# Keep 0.0.0.0 so the published port is reachable.
export BIRTHDAYMEMO_LISTEN_ADDRESS=0.0.0.0
# Host listen port for admin interface service. 
export BIRTHDAYMEMO_ADMIN_HOST_PORT=8080
# Host listen port for guest read-only service.
export BIRTHDAYMEMO_GUEST_HOST_PORT=8081
# Public base URL (with http(s)://) used when building share-link URLs.
# Set this to the PUBLIC hostname, e.g. https://view.example.com.
export BIRTHDAYMEMO_EXTERNAL_URL=https://view.example.com
# Reminder emails are scheduled in local time; set your zone, e.g. TZ=Asia/Shanghai.
export BIRTHDAYMEMO_TZ=UTC
# Console/default language: en | zh.
export BIRTHDAYMEMO_LANGUAGE=en
# Operation log retention days, 0 = unlimited.
export BIRTHDAYMEMO_RETENTION_DAYS=14
# Admin account created on first start (username 3-10 chars).
export BIRTHDAYMEMO_ADMIN_USER=admin
# Admin password (min 8 chars, must contain uppercase, lowercase and digits).
# Empty/invalid = a random compliant password is generated and logged once.
export BIRTHDAYMEMO_ADMIN_PASSWORD=password
# Tag name max length in characters (1-100, default 20).
export BIRTHDAYMEMO_TAG_NAME_MAX_LENGTH=20
# Data directory for persistent storage (relative to the compose.yaml file).
export BIRTHDAYMEMO_DATA_DIR=./data